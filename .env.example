# Copy this file to .env before starting Compose.
# Browser-facing ports.
WEB_UI_PORT=8000
AGENTSCOPE_API_PORT=8001
# Browser-accessible URL used by Logto branding to load the lxScope logo.
# Change this to the public frontend origin outside local development.
LXSCOPE_PUBLIC_URL=http://localhost:8000

# Default login account. Keep AGENTSCOPE_USER_ID=local-user to retain data
# created before JWT login was enabled.
AGENTSCOPE_USERNAME=admin
AGENTSCOPE_USER_ID=local-user
AGENTSCOPE_PASSWORD=change-me
AGENTSCOPE_JWT_SECRET=replace-with-a-different-long-random-secret
AGENTSCOPE_JWT_EXPIRE_MINUTES=1440

# Optional multi-user form. When set, this replaces the single account above.
# AGENTSCOPE_AUTH_USERS={"admin":{"user_id":"local-user","password":"change-me"},"alice":"alice-password"}

# Use a long random value in any non-local deployment.
AGENTSCOPE_DOWNLOAD_SECRET=replace-with-a-long-random-secret

# SiliconFlow is used through its OpenAI-compatible API.
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_CHAT_MODEL=deepseek-ai/DeepSeek-V3.2
# Optional graph extraction model; defaults to SILICONFLOW_CHAT_MODEL.
LXSCOPE_GRAPH_MODEL=
SILICONFLOW_EMBEDDING_MODEL=BAAI/bge-m3
SILICONFLOW_EMBEDDING_DIMENSIONS=1024
QDRANT_PATH=/app/qdrant_data

# Credential boundary: choose exactly one mode per deployment. In tenant mode
# only the verified tenant's admin credentials are shared; platform mode is a
# single platform-owned pool for Platform Admin-managed deployments.
LONGXIN_CREDENTIAL_SCOPE=tenant

# Administrator upgrades and backups. Keep release archives outside the
# source tree. Set the two target directories only after confirming the
# deployment's actual app/core install layout.
LONGXIN_DATA_DIR=/app/longxin-data
LONGXIN_APP_TARGET_DIR=
LONGXIN_CORE_TARGET_DIR=
LONGXIN_UPGRADE_RESTART_COMMAND=
LONGXIN_UPGRADE_HEALTHCHECK_URL=http://127.0.0.1:8000/health

# Optional Redis password. Compose configures the bundled Redis service with
# the same value when it is non-empty.
REDIS_PASSWORD=

# lxScope application-owned PostgreSQL persistence. AgentScope Core remains on
# RedisStorage. The bundled Compose database uses the default URL below.
POSTGRES_DB=lxscope
POSTGRES_USER=lxscope
POSTGRES_PASSWORD=change-me
LXSCOPE_DATABASE_URL=postgresql+asyncpg://lxscope:change-me@postgres:5432/lxscope
LXSCOPE_TASK_STORE_BACKEND=postgres
LXSCOPE_TENANT_CODE=default
LXSCOPE_TENANT_NAME=Default Tenant
# Optional stable UUID. Leave blank to derive one from LXSCOPE_TENANT_CODE.
LXSCOPE_TENANT_ID=

# Logto OSS infrastructure. Logto is the default provider; set both provider
# variables to local only for an explicit local-auth compatibility run.
LOGTO_IMAGE=ghcr.io/logto-io/logto:latest
LOGTO_DATABASE=logto
LOGTO_CORE_PORT=3001
LOGTO_ADMIN_PORT=3002
LOGTO_ENDPOINT=http://localhost:3001
LOGTO_ADMIN_ENDPOINT=http://localhost:3002
LOGTO_TENANT_ID=default
LOGTO_TRUST_PROXY_HEADER=0
# Backend-only Docker network path for Logto signing keys.
LOGTO_JWKS_URL=http://logto:3001/oidc/jwks
# Backend-side OIDC profile endpoint. Leave blank for local development;
# Docker Compose supplies the internal Logto URL.
LOGTO_USERINFO_URL=
LXSCOPE_AUTH_PROVIDER=logto
LOGTO_API_RESOURCE=https://api.lxscope.local
# Logto bootstrap uses a Machine-to-machine application with the built-in
# Logto Management API role. Keep the secret out of version control.
LOGTO_M2M_APP_ID=
LOGTO_M2M_APP_SECRET=
LOGTO_MANAGEMENT_API_RESOURCE=
LOGTO_MANAGEMENT_ENDPOINT=http://localhost:3001
VITE_AUTH_PROVIDER=logto
VITE_LOGTO_ENDPOINT=http://localhost:3001
VITE_LOGTO_APP_ID=
VITE_LOGTO_API_RESOURCE=https://api.lxscope.local

# 新销售总台对接（管理系统侧）。销售总台地址和客户 Token 由销售总台
# 联调时单独分配；不要把生产 Token 写入代码仓库。
LONGXIN_SYSTEM_NAME=Longxin AgentScope
LONGXIN_SYSTEM_ID=local-system
LONGXIN_APP_VERSION=3.8.1
LONGXIN_CORE_VERSION=2.0.8
SALES_CENTER_BASE_URL=
SALES_CENTER_API_TOKEN=
# 生产环境推荐挂载 Docker Secret，并使用下面的文件配置；文件优先于上面的环境变量。
SALES_CENTER_API_TOKEN_FILE=
SALES_CENTER_TIMEOUT_SECONDS=8
SALES_CENTER_VERIFY_TLS=true
SALES_INTEGRATION_ADMIN_USERNAME=admin
LONGXIN_UPGRADE_DIR=/app/upgrade-packages
LONGXIN_POOL_TOKENS=0
LONGXIN_TOTAL_RECHARGED=0.00
LONGXIN_CUMULATIVE_CREDITS=0
# Project-level observability.  Metrics are exposed at
# /observability/metrics for authenticated administrators.
LXSCOPE_OBSERVABILITY_ENABLED=true
LXSCOPE_OBSERVABILITY_MAX_EVENTS=50000
OTEL_SERVICE_NAME=lxscope-agent-service
# Optional OTLP/HTTP endpoint, for example http://otel-collector:4318/v1/traces
OTEL_EXPORTER_OTLP_ENDPOINT=

# Optional overrides for observability. Leave blank to reuse
# LXSCOPE_DATABASE_URL; the project and Skill tables remain separate.
PROJECT_OBSERVABILITY_DATABASE_URL=
SKILL_OBSERVABILITY_DATABASE_URL=

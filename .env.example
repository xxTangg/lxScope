# Copy this file to .env before starting Compose.
# Browser-facing ports.
WEB_UI_PORT=8000
AGENTSCOPE_API_PORT=8001

# Default login account. Keep AGENTSCOPE_USER_ID=local-user to retain data
# created before JWT login was enabled.
AGENTSCOPE_USERNAME=admin
AGENTSCOPE_USER_ID=local-user
AGENTSCOPE_PASSWORD=change-me
AGENTSCOPE_JWT_SECRET=replace-with-a-different-long-random-secret
AGENTSCOPE_JWT_EXPIRE_MINUTES=1440

# Optional multi-user form. When set, this replaces the single account above.
# AGENTSCOPE_AUTH_USERS={"admin":{"user_id":"local-user","password":"change-me"},"alice":"alice-password"}

# Use a long random value in any non-local deployment.
AGENTSCOPE_DOWNLOAD_SECRET=replace-with-a-long-random-secret

# SiliconFlow is used through its OpenAI-compatible API.
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_CHAT_MODEL=deepseek-ai/DeepSeek-V3.2
SILICONFLOW_EMBEDDING_MODEL=BAAI/bge-m3
SILICONFLOW_EMBEDDING_DIMENSIONS=1024
QDRANT_PATH=/app/qdrant_data

# Optional Redis password. Compose configures the bundled Redis service with
# the same value when it is non-empty.
REDIS_PASSWORD=

# 销售 API
SALES_API_PORT=44100
SALES_DATA_DIR=./data
SALES_ADMIN_USERNAME=admin
SALES_ADMIN_PASSWORD=replace-with-a-strong-password

# 生产环境填写真实前端来源；开发环境可留空
WEB_ORIGIN=http://127.0.0.1:44101
SALES_PUBLIC_URL=http://127.0.0.1:44100
CUSTOMER_DOCKER_NETWORK=lxscope2_default

# Docker PostgreSQL；生产环境必须替换密码，并同步更新 DATABASE_URL
POSTGRES_DB=sales_console
POSTGRES_USER=sales
POSTGRES_PASSWORD=change-me-in-production
DATABASE_URL=postgresql://sales:change-me-in-production@sales-postgres:5432/sales_console
